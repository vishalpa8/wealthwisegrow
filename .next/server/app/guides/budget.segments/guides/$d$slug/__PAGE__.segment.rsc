0:{"rsc":["$","$1","c",{"children":[["$","article",null,{"className":"prose prose-neutral max-w-none card p-8","children":[["$","p",null,{"className":"text-sm font-semibold uppercase tracking-wide text-primary-600","children":"Personal finance guide"}],["$","h1",null,{"className":"text-3xl font-bold text-neutral-900 mt-2","children":"Monthly Budgeting Guide India"}],["$","p",null,{"className":"text-lg text-neutral-600 leading-relaxed","children":"Build a practical monthly budget around income, fixed expenses, goals, savings, and debt control."}],[["$","section","Budgeting is cash-flow control",{"className":"mt-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-neutral-900 mb-4","children":"Budgeting is cash-flow control"}],[["$","p","A budget is not about cutting every expense. It is a way to decide where income should go before it disappears into random spending.",{"className":"text-neutral-600 leading-relaxed mb-4","children":"A budget is not about cutting every expense. It is a way to decide where income should go before it disappears into random spending."}],["$","p","Start by separating fixed commitments, flexible spending, debt payments, insurance, emergency savings, and goal investments.",{"className":"text-neutral-600 leading-relaxed mb-4","children":"Start by separating fixed commitments, flexible spending, debt payments, insurance, emergency savings, and goal investments."}]]]}],["$","section","Savings rate matters more than perfect categories",{"className":"mt-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-neutral-900 mb-4","children":"Savings rate matters more than perfect categories"}],[["$","p","A common framework is 50% needs, 30% wants, and 20% savings, but Indian household budgets vary by city, rent, dependents, and family responsibilities.",{"className":"text-neutral-600 leading-relaxed mb-4","children":"A common framework is 50% needs, 30% wants, and 20% savings, but Indian household budgets vary by city, rent, dependents, and family responsibilities."}],["$","p","The important number is your sustainable savings rate. Even a 10% starting savings rate can improve if income grows and lifestyle inflation is controlled.",{"className":"text-neutral-600 leading-relaxed mb-4","children":"The important number is your sustainable savings rate. Even a 10% starting savings rate can improve if income grows and lifestyle inflation is controlled."}]]]}],["$","section","Plan for irregular expenses",{"className":"mt-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-neutral-900 mb-4","children":"Plan for irregular expenses"}],[["$","p","Annual insurance premiums, school fees, travel, festivals, medical costs, and repairs can break a monthly budget if they are not planned in advance.",{"className":"text-neutral-600 leading-relaxed mb-4","children":"Annual insurance premiums, school fees, travel, festivals, medical costs, and repairs can break a monthly budget if they are not planned in advance."}],["$","p","Create sinking funds for predictable irregular expenses so they do not become credit card debt.",{"className":"text-neutral-600 leading-relaxed mb-4","children":"Create sinking funds for predictable irregular expenses so they do not become credit card debt."}]]]}]],["$","section",null,{"className":"mt-8 grid gap-6 lg:grid-cols-2","children":[["$","div",null,{"className":"rounded-lg bg-neutral-50 p-5","children":[["$","h2",null,{"className":"text-xl font-bold text-neutral-900 mb-3","children":"Action checklist"}],["$","ul",null,{"className":"space-y-2 text-neutral-600","children":[["$","li","List all fixed monthly commitments.",{"children":["- ","List all fixed monthly commitments."]}],"$L2","$L3","$L4","$L5"]}]]}],"$L6"]}],"$L7"]}],null,"$L8"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"Ax3wWi7V9jZ9YxrzlbMEm"}
